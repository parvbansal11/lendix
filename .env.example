# Replace placeholders locally; never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_DEEP=
# Thinking depth for each model call: minimal, low, medium, high or off. Low keeps steps fast.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=90000
ENV=production
DB_PATH=var/lendix.db
OUTPUT_DIR=out
CREDIT_POLICY_PATH=config/credit_policy.yaml
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_LLM_CALLS_PER_DAY=500
COOLING_OFF_DAYS=1
# Synthetic demo only: skips the pre-payout wait, not borrower acceptance or exit rights.
DEMO_SKIP_COOLING_OFF=0
NONILION_DEV_ALLOW_UNVERIFIED=0
NONILION_PAIRING_CODE=
NONILION_BOT_TOKEN=
# Nonilion MCP personal token (Mission Control -> MCP -> Personal tokens). Switches the office on.
NONILION_MCP_TOKEN=
# Optional: room id (defaults to the token's room) and the risk head's Nonilion handle (defaults to the room owner).
NONILION_ROOM=
NONILION_RISK_HEAD=
# Optional: a separate token per agent gives it its own avatar, e.g. NONILION_TOKEN_REPORTER, NONILION_TOKEN_RISK.
